// Shared config for all build variants.
// NASA_API_KEY is intentionally empty here: the real value lives in Secrets.xcconfig
// (gitignored, see Secrets.example.xcconfig), which Debug/Release include after this file.

NASA_API_KEY =
INFOPLIST_KEY_NASA_API_KEY = $(NASA_API_KEY)

// Version shown in the App Store and the build number for TestFlight. Every target reads these,
// so a new TestFlight build only needs CURRENT_PROJECT_VERSION bumped here.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 3
